(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defcfg 
  process-unmapped-keys yes
  concurrent-tap-hold yes
  tray-icon "./icon/K.png"
)

(defalias
  toNav (tap-hold-release 200 200 esc (layer-toggle navigation))
  toNum (tap-hold-press 200 600 x (layer-toggle numbers))
  toSymA(tap-hold-press 200 600 z (layer-toggle symbolsA))
  toSymB (tap-hold-press 200 600 , (layer-toggle symbolsB))
  toSymC (tap-hold-press 200 600 . (layer-toggle symbolsC))
  toFunc (tap-hold-release 200 200 tab (layer-toggle function))
  shiftCaps (tap-hold 200 200 (tap-dance 200 ((caps-word 10000) (one-shot 2000 lsft))) lshift)
  slashAlt (tap-hold 200 200 (tap-dance 200 (/ (layer-switch navigation))) ralt)
  slashCtrl (tap-hold 200 200 / rctrl)
  ;; slashShift (tap-hold 200 200 / rsft)
  metaHold (one-shot 2000 lmet)
  ;; mAlt (tap-hold 200 200 m ralt)
  ;; cAlt (tap-hold 200 200 c ralt)
  lAltw (tap-hold-release 400 600 w lalt)
  lCtle (tap-hold-release 400 600 e lctl)

  rAlto (tap-hold-release 400 600 o ralt)
  rCtli (tap-hold-release 400 600 i rctl)

  lmetq (tap-hold-release 400 600 q lmet)
  rmetp (tap-hold-release 400 600 p lmet)

  lsftr (tap-hold-release 400 600 r lsft)
  rsftu (tap-hold-release 400 600 u rsft)

  lsftLayer (layer-toggle layerLShift)
  rsftLayer (layer-toggle layerRShift)

  ;; spcMouse (tap-hold 200 200 spc (layer-toggle mouse))
  ;; aralt (tap-hold 200 200 (layer-switch mouse) ralt)
  ;; symb (tap-hold 200 200 / (layer-toggle symbols))
  ;; htoNum (tap-hold 200 200 s lalt)
  ;; htoSymA(tap-hold 200 200 l lalt)
  ;; hshift1 (tap-hold 200 200 d lshift)
  ;; hshift2 (tap-hold 200 200 k lshift)
  ;; hctrl1 (tap-hold 200 200 f lctrl)
  ;; hctrl2 (tap-hold 200 200 j lctrl)
  ;; lmod (tap-hold 200 200 c (layer-toggle leftExtra))
  ;; rmod (tap-hold 200 200 m (layer-toggle rightExtra))
  ;; funa (tap-hold 200 200 a (layer-toggle functions))
  ;; funb (tap-hold 200 200 ; (layer-toggle functions))
  ;; swiSym (layer-switch symbols)
  ;; swiDef (layer-switch default)
)

(defchordsv2
  (lsft /) (caps-word 5000) 200 all-released ()
)

(deflayer default
  esc             1               2               3               4               5               6               7               8               9               0               -               =               bspc
  @toFunc         @lmetq          @lAltw          @lCtle          @lsftr          t               y               @rsftu          @rCtli          @rAlto          @rmetp          bspc            ]               \  
  @toNav          a               s               d               f               g               h               j               k               l               ;               ret             ret
  lsft            @toSymA         @toNum          c               v               b               n               m               @toSymB         @toSymC         rsft            @slashAlt
  lctl            lmet            lalt                                            _                                               ralt            rmet            rctl
)

(deflayer (navigation icon "./icon/N.png")
  _               _               _               _               _               _               _               _               _               _               _               _               _              _
  _               VolumeDown      VolumeUp        VolumeMute      MediaPlayPause  _               _               home            tab             end             lmet            C-bspc          _              _
  _               @metaHold       lalt            lshift          lctrl           _               left            down            up              right           _               menu            _
  _               (layer-switch mouse)    del     _               _               _               _               pgdn            pgup            _               _               (layer-switch default) 
  _               _               _                                               _                                              lrld            _                caps
)

(deflayer (layerLShift)
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  XX    XX    XX    XX    XX    S-y    S-u    S-i    S-o    S-p    [    ]    \
  caps XX    XX    XX    XX    XX    S-h    S-j    S-k    S-l    S-;    '    ret
  lsft XX    XX    XX    XX    XX    S-n    S-m    S-,    S-.    S-/    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer (layerRShift)
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  S-q    S-w    S-e    S-r    S-t    XX    XX    XX    XX    XX   [    ]    \
  caps S-a    S-s    S-d    S-f    S-g    XX    XX    XX    XX    XX    '    ret
  lsft S-z    S-x    S-c    S-v    S-b    XX    XX    XX    XX    XX    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)


