(deflayer function
   _   _   _   _    _    _    _    _    _    _    _    _   _ _
  _  _   _  _    _    _  _    F1    F2    F3    F4    _    _    _
  _  _    lalt   lsft    lctl  _ _    F5    F6    F7    F8     _    _
  _ _  _    _    _    _    _   F9    F10    F11    F12    _
  _ _ _           _            _ _ _
