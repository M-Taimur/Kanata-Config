(deflayer (mouse icon "./icon/M.png")
  _  _    _    _    _    _    _    _    _    _    _    _    _    _
  _  _    mrgt    mmid    mlft    _    _    _    _    _    _    _    _    _
  (layer-switch default)  _    mrtp    mmtp    mltp    _    _    _    _    _    _    _    _
  _  _    (mwheel-up 50 120)    (mwheel-down 50 120)    (mwheel-left 50 120)    (mwheel-right 50 120) _  _    _    _    _    _
  _ _ _           _             _ _ _
)